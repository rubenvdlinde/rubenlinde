# Council of LLMs - Environment Configuration
# Copy this file to .env and adjust values as needed

# PostgreSQL Configuration
POSTGRES_PASSWORD=your-secure-password-here

# n8n Configuration
N8N_USER=admin
N8N_PASSWORD=your-secure-password-here
N8N_HOST=localhost

# Redis Configuration
REDIS_PASSWORD=your-secure-password-here

# Ollama Configuration
# Number of parallel model requests (adjust based on available VRAM)
# Single RTX 4090 (24GB): 2-3
# Dual RTX 4090 (48GB): 4-6
# Quad RTX 4090 (96GB): 8-10
OLLAMA_NUM_PARALLEL=4

# Maximum number of models loaded in memory simultaneously
# Single GPU: 1-2
# Dual GPU: 2-3
# Quad GPU: 4+
OLLAMA_MAX_LOADED_MODELS=2

